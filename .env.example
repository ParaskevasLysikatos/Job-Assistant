# TEMPLATE ONLY - keep this file free of real keys, it is committed to git.
# Copy it to `.env` (gitignored) and put your real keys there.
#
# Every key is OPTIONAL: sources without a key are skipped automatically.
# The JobSpy scrapers (Indeed / LinkedIn / Google Jobs) need NO keys at all.

# --- Adzuna (covers Germany, Austria, Netherlands, Switzerland - NOT Greece or Malta) ---
# Register (instant, free, ~1000 calls/month): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Jooble (covers all 6 countries) ---
# Register one key per country domain (free, but 500 requests LIFETIME per key):
#   Germany:     https://de.jooble.org/api/about
#   Austria:     https://at.jooble.org/api/about
#   Netherlands: https://nl.jooble.org/api/about
#   Switzerland: https://ch.jooble.org/api/about
#   Greece:      https://gr.jooble.org/api/about
#   Malta:       https://mt.jooble.org/api/about
JOOBLE_KEY_DE=
JOOBLE_KEY_AT=
JOOBLE_KEY_NL=
JOOBLE_KEY_CH=
JOOBLE_KEY_GR=
JOOBLE_KEY_MT=
# Fallback key tried for any country without a specific key above:
JOOBLE_KEY=
